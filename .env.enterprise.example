# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=
# API hardening (adjust at the reverse proxy for multi-instance deployments)
ASTOCK_MAX_REQUEST_BYTES=1048576
ASTOCK_RATE_LIMIT_PER_MINUTE=300
ASTOCK_SSE_MAX_CLIENTS=50
ASTOCK_COOKIE_SECURE=true
PG_PASSWORD=
CLICKHOUSE_PASSWORD=
PGADMIN_PASSWORD=
CORS_ORIGIN=https://your-public-ui.example.com
# OPENAI_API_VERSION=2024-10-21  # optional, required for non-v1 API
