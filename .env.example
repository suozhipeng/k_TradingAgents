# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Optional: override DEFAULT_CONFIG without editing code.
# Any TRADINGAGENTS_* variable below, when set, replaces the matching key
# in tradingagents/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"/"3" work as expected.
# In the CLI, setting the LLM provider / models / backend URL / language
# also skips the matching interactive selection step (useful for
# OpenAI-compatible endpoints like opencode or LM Studio, and unattended runs).
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
# A-share live runtime profile. When set to live_research, the A-share
# runtime uses real LLM clients instead of BridgeLLM and fails closed if any
# required client or API key is missing.
#TRADINGAGENTS_ASTOCK_RUNTIME_PROFILE=live_research
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false
# Sampling temperature (lower = less run-to-run variation on models that
# honor it). Unset leaves each provider at its default. See the README
# "Reproducibility" note — no setting makes LLM output fully deterministic.
#TRADINGAGENTS_TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# AStock local-release / single canonical DuckDB (PR-2)
# ---------------------------------------------------------------------------
# Force analysis-and-backtest-only mode: disables scheduler, trading APIs,
# mock-data fallback, and second K-line warehouse.
#ASTOCK_LOCAL_RELEASE=true

# When enabled, all reads/writes go through this single DuckDB file.
# This must be "duckdb" under local-release; PostgreSQL is forbidden.
#ASTOCK_DB_BACKEND=duckdb

# Canonical DuckDB path for local-release.  Must point to
# ~/.tradingagents/astock/astock.duckdb.
#ASTOCK_DB_PATH=~/.tradingagents/astock/astock.duckdb

# Mock data is NOT permitted under local-release.
#ASTOCK_MOCK_DATA_ENABLED=false

# Permanent (second) K-line DuckDB is disabled under local-release.
#ASTOCK_PERMANENT_KLINE_ENABLED=false

# Migration script source database path (optional override).
#ASTOCK_MIGRATE_SOURCE=kline/kline.duckdb

# ---------------------------------------------------------------------------
# Provider (V1.6.1) — Community data stack: Mootdx + AKShare + BaoStock + Cninfo
# ---------------------------------------------------------------------------
# No commercial token required.
# Mootdx: A-share market kline, index kline, realtime quote (primary)
# AKShare: financials, valuation, capital flow, sectors, limit-up, news
# BaoStock: trade calendar, security master, adjustment factor, historical kline
# Cninfo (巨潮): official announcements, corporate events

# Provider deployment mode: community | offline_cache
#ASTOCK_PROVIDER_MODE=community

# Path to provider policy YAML (relative to repo root or absolute)
#ASTOCK_PROVIDER_POLICY_PATH=config/provider_policy.yaml

# Provider cache TTL in seconds
#ASTOCK_PROVIDER_CACHE_TTL_SECONDS=60

# Provider request timeout in seconds
#ASTOCK_PROVIDER_REQUEST_TIMEOUT_SECONDS=10
#ASTOCK_PROVIDER_MAX_RETRIES=1

# Cninfo access mode: public | local_import | cache_only
#ASTOCK_CNINFO_MODE=public_or_local_import

# Cninfo local import directory
#ASTOCK_CNINFO_LOCAL_DIR=data/local/cninfo
